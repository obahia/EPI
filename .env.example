# Copy to `.env` for local development, and set every one of these in your hosting
# provider (Vercel: Project > Settings > Environment Variables) before deploying.
#
# All six are REQUIRED. The app boots and even signs you in with only the Supabase
# three, which is misleading -- the crypto secrets below are read lazily, so a missing
# one does not fail at startup. It fails the first time somebody generates a
# confirmation link or registers an employee, as an uncaught 500.

# --- Supabase ---------------------------------------------------------------

# Supabase project settings — Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase project settings — Settings > API > Publishable key
# NEW key format (sb_publishable_...), NOT the legacy `anon` JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Supabase project settings — Settings > API > Secret key. Server-only, never
# expose with a NEXT_PUBLIC_ prefix.
# NEW key format (sb_secret_...), NOT the legacy `service_role` JWT key.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- Application secrets ----------------------------------------------------
#
# These live in the APPLICATION environment, never in Supabase Vault: the realistic
# breach is a database dump, and Vault is inside the database (docs/architecture.md §8).
#
# Generate each one separately -- three DIFFERENT values:
#
#     openssl rand -base64 32
#
# ⚠ THESE VALUES ARE NOT INTERCHANGEABLE BETWEEN ENVIRONMENTS.
# Any environment pointing at the SAME Supabase project must use the SAME values.
# Changing one against existing data:
#   CPF_ENCRYPTION_KEY  -> already-encrypted CPFs become permanently undecryptable
#   CPF_HASH_PEPPER     -> employee dedupe breaks; the 3-digit CPF challenge fails for
#                          every existing employee
#   WORKER_TOKEN_PEPPER -> confirmation links already sent stop opening (recoverable:
#                          issue new links)

# HMAC pepper for the deterministic CPF hash used for dedupe/lookup.
CPF_HASH_PEPPER=

# AES-256-GCM key for CPF encryption at rest. MUST decode to exactly 32 bytes.
CPF_ENCRYPTION_KEY=

# HMAC pepper for worker confirmation-link tokens. The raw token never reaches
# Postgres -- only its HMAC does (app.confirmation_requests.token_hash).
WORKER_TOKEN_PEPPER=
